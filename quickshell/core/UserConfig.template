// core/UserConfig.template
// Copy this file to UserConfig.qml and fill in your values before running.
pragma Singleton
import QtQuick
import Quickshell

Item {
    // Holiday calendar ICS URL from Google Calendar
    // How to get yours:
    // 1. Go to https://calendar.google.com
    // 2. On the left sidebar, find "Other calendars" and click the + button
    // 3. Browse "Browse calendars of interest" → Holidays → select your country
    // 4. Go to Settings → click your holiday calendar → scroll to "Integrate calendar"
    // 5. Copy the "Secret address in iCal format" or "Public address in iCal format"
    // 6. Paste it below
    property string holidayCalendarUrl: ""

    // First day of week: 0 = Sunday, 1 = Monday
    property int firstDayOfWeek: 0

    // Weather — city name is resolved to coordinates automatically on startup
    // Examples: "New York", "Los Angeles", "London", "Tokyo"
    property string city: "New York"

    // Temperature unit: "celsius" or "fahrenheit"
    property string temperatureUnit: "fahrenheit"

    // The Tower — automation daemon (Auto-Run, Auto-Gem) and the apps the launcher opens
    property string towerService:        "towerd.service"
    property string towerDaemon:         Quickshell.env("HOME") + "/Agents/towersuite/towerd/towerd.py"
    property string towerStatusFile:     Quickshell.env("XDG_RUNTIME_DIR") + "/towersuite/towerd/status.json"
    property string towerPackage:        "com.TechTreeGames.TheTower"
    property string towerRendPath:       Quickshell.env("HOME") + "/Applications/RendAppLatest.AppImage"
    property string towerHeliumLauncher: Quickshell.env("HOME") + "/.config/hypr/scripts/helium-safe-launch"
    property string towerHeliumProfile:  "Profile 1"

    // Waydroid tile width (fix layout restores it; Auto-Run's retry_button.png is matched at this size)
    property int towerWaydroidWidth:  450
}

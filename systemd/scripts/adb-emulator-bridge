#!/usr/bin/env bash
# ADB bridge to the laptop's Android emulator: localhost:5555 -> 192.168.69.15:5555, but only while the emulator
# actually answers. When it's gone, the bridge is torn down and adb forgets the device, so adb stops retrying
# (it used to log "No route to host" every 3 s). Run by adb-emulator-bridge.service.
# Only touches localhost:5555; towerd's Waydroid device (192.168.240.112:5555) is left alone.

HOST=${ADB_BRIDGE_HOST:-192.168.69.15}
PORT=${ADB_BRIDGE_PORT:-5555}
CHECK_EVERY=${ADB_BRIDGE_INTERVAL:-30}

socat_pid=""

reachable() { timeout 2 bash -c "</dev/tcp/$HOST/$PORT" 2>/dev/null; }

forget() {
    adb disconnect "localhost:$PORT" >/dev/null 2>&1
    adb disconnect "127.0.0.1:$PORT" >/dev/null 2>&1
}

bridge_up() {
    socat TCP-LISTEN:"$PORT",fork,reuseaddr,bind=127.0.0.1 TCP:"$HOST":"$PORT" &
    socat_pid=$!
    sleep 1
    adb connect "localhost:$PORT" >/dev/null 2>&1
    echo "emulator at $HOST:$PORT is up: bridge on, adb connected"
}

bridge_down() {
    forget
    if [ -n "$socat_pid" ]; then
        kill "$socat_pid" 2>/dev/null
        wait "$socat_pid" 2>/dev/null
    fi
    socat_pid=""
    echo "emulator at $HOST:$PORT is gone: bridge off, adb disconnected"
}

trap 'bridge_down; exit 0' TERM INT

forget   # clear a stale entry from before this started
echo "watching $HOST:$PORT every ${CHECK_EVERY}s"
while true; do
    # socat died on its own: treat the bridge as down
    if [ -n "$socat_pid" ] && ! kill -0 "$socat_pid" 2>/dev/null; then
        socat_pid=""
    fi
    if reachable; then
        [ -z "$socat_pid" ] && bridge_up
    else
        [ -n "$socat_pid" ] && bridge_down
    fi
    sleep "$CHECK_EVERY" &
    wait $!
done

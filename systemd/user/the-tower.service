[Unit]
Description=The Tower daemon (Auto-Run, Auto-Gem)
# Parts are switched on/off at runtime via $XDG_RUNTIME_DIR/the-tower/control.json
# Taps and screenshots go to Waydroid over ADB, so no ydotool or visible window needed
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/lruego/Agents/towerd/venv/bin/python /home/lruego/Agents/towerd/the_tower.py
WorkingDirectory=/home/lruego/Agents/towerd
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target

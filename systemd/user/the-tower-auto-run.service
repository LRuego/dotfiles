[Unit]
Description=The Tower Auto Run (PyAutoGUI Script)
After=graphical-session.target

[Service]
Type=simple
# Crucial for PyAutoGUI: It needs access to your display server (X11/Wayland)
Environment="DISPLAY=:0"
# Force Python to print logs immediately instead of buffering them
Environment="PYTHONUNBUFFERED=1"
# If you use Wayland, you might also need WAYLAND_DISPLAY
# Environment="WAYLAND_DISPLAY=wayland-0"

ExecStart=/home/lruego/pyautogui/venv/bin/python /home/lruego/pyautogui/The_Tower-Auto-Run.py
WorkingDirectory=/home/lruego/pyautogui
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
